generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  status    String
  createdAt DateTime @default(now())
}

model Player {
  id          Int      @id @default(autoincrement())
  username    String
  telegramId  String
  phoneNumber String
  balance     Int
  joinedAt    DateTime @default(now())
}

model Winner {
  id        Int      @id @default(autoincrement())
  name      String
  gameCode  String
  createdAt DateTime @default(now())
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id         Int       @id @default(autoincrement())
  betAmount  Int
  status     String    @default("waiting")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  players    Player[]  @relation("GamesPlayed")
  winnerId   Int?      
  winner     Player?   @relation("GamesWon", fields: [winnerId], references: [id])
}

model Player {
  id          Int      @id @default(autoincrement())
  username    String
  telegramId  String   @unique
  phoneNumber String
  balance     Int
  joinedAt    DateTime @default(now())

  // Relations
  games       Game[]   @relation("GamesPlayed") // Games they've played
  wonGames    Game[]   @relation("GamesWon")    // Games they've won

  // Reverse relations for payment request and deposit sessionData
  paymentRequests PaymentRequest[]
  paymentSessions PaymentSession[]
  
  
}


model Winner {
  id        Int      @id @default(autoincrement())
  name      String
  gameCode  String
  createdAt DateTime @default(now())
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String

  role      String   @default("admin") // admin, super_admin
  status    String   @default("active") // active, inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Promotion {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  type            String   // deposit_bonus, free_credits, cashback, referral_bonus
  value           Int      // bonus amount or percentage
  valueType       String   // fixed, percentage
  minDeposit      Int?     // minimum deposit required
  maxBonus        Int?     // maximum bonus amount
  code            String?  @unique // promo code
  isActive        Boolean  @default(true)
  startDate       DateTime
  endDate         DateTime?
  usageLimit      Int?     // total usage limit
  usageCount      Int      @default(0) // current usage count
  playerUsageLimit Int?    // per player usage limit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

 
}


model PaymentReceiverDetails {
  id          Int      @id @default(autoincrement())
  phoneNumber String?
  accountNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentRequest {
  id          Int      @id @default(autoincrement())
  playerId      Int
  amount      Float
  status      String   @default("pending") // pending, approved, rejected, completed
  txRef       String?  @unique
  phoneNumber String?
  accountNumber String?
  bankName    String?
  reason      String?  // for rejections
  processedBy Int?     // admin who processed the request
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  player      Player   @relation(fields: [playerId], references: [id])
}


model PaymentSession {
  id          Int      @id @default(autoincrement())
  playerId      Int
  amount      Float
  txRef       String   @unique
  status      String   @default("pending") // pending, completed, failed, cancelled
  paymentMethod String // cbe, telebirr, cbe, etc.
  sessionData Json?    // store payment provider specific data
  expiresAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  player      Player   @relation(fields: [playerId], references: [id])
}








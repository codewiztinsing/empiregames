generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id         Int       @id @default(autoincrement())
  betAmount  Int
  status     String    @default("waiting")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  players    Player[]  @relation("GamesPlayed")
  winnerId   Int?      
  winner     Player?   @relation("GamesWon", fields: [winnerId], references: [id])
}

model Player {
  id          Int      @id @default(autoincrement())
  username    String
  telegramId  String
  phoneNumber String
  balance     Int
  joinedAt    DateTime @default(now())

  // Relations
  games       Game[]   @relation("GamesPlayed") // Games they've played
  wonGames    Game[]   @relation("GamesWon")    // Games they've won

  // Reverse relations for deposits and withdrawals
  deposits      Deposit[]     @relation("PlayerDeposits")
  withdrawals   Withdrawal[]  @relation("PlayerWithdrawals")
}

model Deposit {
  id        Int      @id @default(autoincrement())
  amount    Int
  playerId  Int
  status    String   @default("pending") // pending, completed, failed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  player    Player   @relation("PlayerDeposits", fields: [playerId], references: [id])
}

model Withdrawal {
  id        Int      @id @default(autoincrement())
  amount    Int
  playerId  Int
  status    String   @default("pending") // pending, completed, failed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  player    Player   @relation("PlayerWithdrawals", fields: [playerId], references: [id])
}



model Winner {
  id        Int      @id @default(autoincrement())
  name      String
  gameCode  String
  createdAt DateTime @default(now())
}

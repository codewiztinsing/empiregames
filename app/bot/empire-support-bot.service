[Unit]
Description=Empire Games Support Bot
After=network.target
Wants=network.target

[Service]
Type=simple
User=tinsae
Group=tinsae
WorkingDirectory=/home/tinsae/Desktop/projects/empiregames/app/bot
Environment=PATH=/home/tinsae/Desktop/projects/empiregames/app/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/tinsae/Desktop/projects/empiregames/app
ExecStart=/home/tinsae/Desktop/projects/empiregames/app/venv/bin/python support.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=empire-support-bot

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/tinsae/Desktop/projects/empiregames/logs

[Install]
WantedBy=multi-user.target

# Liyu Bingo Telegram Bot Production Environment Configuration
# Copy this file to .env.production and update the values

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=akerbingo.com,server.akerbingo.com

# Database (if using external database)
# DATABASE_URL=postgresql://user:password@localhost:5432/liyu_bingo

# Bot Configuration
BOT_TOKEN=your-telegram-bot-token-here
BACK_URL=https://akerbingo.com

# Manual Payment API
MANUAL_API_KEY=your-manual-api-key
MANUAL_BASE_URL=https://your-manual-payment-api.com/

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/liyu-bot/bot.log

# Security
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Static Files
STATIC_ROOT=/home/tinsae/Desktop/projects/empiregames/app/staticfiles
MEDIA_ROOT=/home/tinsae/Desktop/projects/empiregames/app/media

# Email (if needed)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
